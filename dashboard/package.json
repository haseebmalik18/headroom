{
  "name": "hotpath-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:cloudflare": "tsc && vite build --mode cloudflare --base / --outDir dist-cloudflare",
    "test:cloudflare": "node --test cloudflare/worker.test.mjs",
    "preview:cloudflare": "wrangler dev --local",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4",
    "wrangler": "4.86.0"
  }
}
